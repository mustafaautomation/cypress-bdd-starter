{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "cypress",
      "node"
    ],
    "moduleResolution": "bundler"
  },
  "include": [
    "cypress/**/*.ts"
  ]
}
