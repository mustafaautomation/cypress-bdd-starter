{
  "name": "cypress-bdd-starter",
  "version": "1.0.0",
  "description": "Cypress + Cucumber BDD framework with TypeScript POM \u2014 SauceDemo reference implementation",
  "author": "Quvantic <info@quvantic.com> (https://quvantic.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaautomation/cypress-bdd-starter.git"
  },
  "homepage": "https://github.com/mustafaautomation/cypress-bdd-starter#readme",
  "bugs": {
    "url": "https://github.com/mustafaautomation/cypress-bdd-starter/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "cypress run",
    "test:smoke": "cypress run --expose tags=@smoke",
    "test:regression": "cypress run --expose tags=@regression",
    "test:headed": "cypress run --headed",
    "open": "cypress open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mocha-junit-reporter": "^2.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/support/step_definitions/**/*.ts"
  }
}
